{
  "manifest_version": 3,
  "name": "Contexa",
  "version": "0.1.0",
  "description": "网页上下文标注与交付工具，将说明精准绑定到页面元素，并以结构化数据交付给团队或 AI",
  "permissions": ["activeTab", "sidePanel", "storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_title": "Contexa",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["shared.js", "i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
